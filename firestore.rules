rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      // 로컬스토리지에서 로그인 정보를 읽을 수 없으므로,
      // 클라이언트가 데이터를 읽을 때만 이 규칙이 작동합니다.
      // 보안은 클라이언트에서 처리 (간단한 앱이므로)
      return true;
    }

    // ⚠️ 아래 아이디 목록을 js/firebase-config.js 의 ADMIN_USERNAMES 와
    //    반드시 똑같이 맞춰주세요. 관리자를 추가/변경하면 여기와 firebase-config.js
    //    두 군데를 모두 수정한 뒤, 이 규칙을 다시 게시(Publish)해야 적용됩니다.
    function isAdmin(username) {
      return username in [
        'boss'
      ];
    }

    // 사용자 프로필: 누구나 읽을 수 있고,
    // 본인이 수정할 수 있습니다.
    match /users/{uid} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // 근무표: 누구나 볼 수 있고, 클라이언트에서 접근 제어
    match /schedules/{id} {
      allow read: if true;
      allow write: if true;
    }

    // 알바비: 누구나 접근 가능, 클라이언트에서 접근 제어
    match /payroll/{id} {
      allow read: if true;
      allow write: if true;
    }
  }
}
